---
import Header from "./Header.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="stylesheet"
      href="https://unpkg.com/ress@4.0.0/dist/ress.min.css"
    />
    <title>Astro</title>
  </head>
  <body>
    <Header />
    <slot />
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/gsap@3.13/dist/gsap.min.js"></script>
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/gsap@3.13/dist/Observer.min.js"
    ></script>
  </body>
</html>
