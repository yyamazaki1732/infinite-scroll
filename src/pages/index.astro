---
import BaseLayout from "../../components/layouts/BaseLayout.astro";
import "fullpage.js/dist/fullpage.css";

const sections = [
  {
    id: "section1",
    content: "「まだ、あきらめてないだろ？」篇",
    hex: "#FF5733",
  },
  {
    id: "section2",
    content: "PERFECT WASH",
    hex: "#33FF57",
  },
  {
    id: "section3",
    content: "BLACK PLUS SHAMPOO",
    hex: "#3357FF",
  },
  {
    id: "section4",
    content: "BODY SOAP PERFECT WASH",
    hex: "#F1C40F",
  },
  {
    id: "section5",
    content: "DEODORANT BODY MIST",
    hex: "#8E44AD",
  },
  {
    id: "section6",
    content: "LINE UP",
    hex: "#E67E22",
  },
];
---

<BaseLayout>
  <div data-fullpage-container>
    {
      sections.map((section) => (
        <div
          class="section"
          style={`background-color: ${section.hex};`}
          id={section.id}
        >
          <section class:list={["inner"]}>
            <h2 class:list={["title"]}>{section.content}</h2>
          </section>
        </div>
      ))
    }
  </div>
</BaseLayout>

<script>
  import "public/scripts/infinite-scroll";
</script>

<style>
  :where([data-fullpage-container]) {
    .section {
      height: 100%;
      width: 100%;
    }
    :where(.section) {
      .inner {
        --pad-i: 2rem;
        padding-inline: var(--pad-i);
        height: 100%;
        width: 100%;
        display: grid;
        place-items: center;
      }
      :where(.inner) {
        .title {
          font-size: 2rem;
          color: white;
          opacity: 0;
          transform: translateY(100%);
        }
      }
    }
  }
</style>
